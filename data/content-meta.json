  "history": {
   "5": {"h":[{"d":"84","e":"95","p":[{"t":"律師應精研法令，充實法律專業知識，吸收時代新知，提昇法律服務品質。","ks":[]}]},{"d":"95","e":"98","p":[{"t":"律師應精研法令，充實法律專業知識，吸收時代新知，提昇法律服務品質，並依全聯會理事會所訂在職進修辦法，每年至少完成六小時之在職進修課程。","ks":[]}]}]},
   "6": {"h":[{"d":"84","e":"98","p":[{"t":"律師應謹言慎行，端正社會風氣，作為社會之表率。","ks":[]}]}]},
   "9": {"h":[{"d":"84","e":"98","p":[{"t":"律師應參與平民法律服務，或從事其他社會公益活動，以普及法律服務。","ks":[]}]}]},
   "10": {"h":[{"d":"84","e":"98","p":[{"t":"律師對於所屬律師公會就倫理風紀事項之查詢應據實答覆。","ks":[]}]}]},
   "12": {"h":[{"d":"84","e":"98","p":[{"t":"律師不得以誇大不實之宣傳支付介紹人報酬、聘雇業務人員或其他不正當之方法招攬業務。","ks":[]}]}]},
   "14": {"h":[{"d":"84","e":"98","p":[{"t":"律師不得以關說事件或招攬業務之目的，與司法人員為不正當之往還酬應。","ks":[]}]}]},
   "15": {"h":[{"d":"84","e":"98","p":[{"t":"律師事務所聘僱助理人員，應遴選品行端正者擔任之。","ks":[]},{"t":"律師應負責督導助理人員不得有違法或不當之行為。","ks":[]}]}]},
   "16": {"h":[{"d":"84","e":"98","p":[{"t":"律師得於法庭外向證人詢問其所知之事實，但該詢問以就必要事實之說明或為辯護有必要者為限，不得誘導證人不實之陳述。","ks":[]}]}]},
   "18": {"h":[{"d":"84","e":"87","p":[{"t":"律師曾任法官或檢察官者，於離職後三年內，不得於其原任職法院及檢察署管轄區域執行律師職務或僱用其他律師代行律師職務，亦不得以任何名義設立聯絡處、分所或揭示招牌。","ks":[]}]}]},
   "22": {"h":[{"d":"84","e":"98","p":[{"t":"律師對於司法機關指定辯護之案件，不得無故拒絕或延宕，亦不得自被告或其他關係人收取報酬或費用。","ks":[]}]}]},
   "23": {"h":[{"d":"84","e":"98","p":[{"t":"律師於執行職務時，不得有故為矇蔽欺罔之行為，亦不得偽造變造證據、教唆偽證或為其他刻意阻礙真實發現之行為。","ks":[]}]}]},
   "24": {"h":[{"d":"84","e":"98","p":[{"t":"律師不得惡意詆譭司法人員或司法機關；對於司法人員貪污有據者，應予舉發。","ks":[]}]}]},
   "25": {"h":[{"d":"84","e":"98","p":[{"t":"律師對於司法機關詢問、囑託、指定之案件，應儘量予以協助。","ks":[]}]}]},
   "26": {"h":[{"d":"84","e":"98","p":[{"t":"律師應依據法令及正當程序，儘力維護當事人之合法權益，對於受任事件之處理，不得無故延宕，並應及時告知事件進行之重要情事。","ks":[]}]}]},
   "28": {"h":[{"d":"84","e":"98","p":[{"t":"律師就受任事件，不得擔保將有利結果。","ks":[]}]}]},
   "29": {"h":[{"d":"84","e":"98","p":[{"t":"律師於執行職務時，如發現和解息訟符合當事人之利益及法律正義時，宜協力促成之。","ks":[]}]}]},
   "30": {
    "h": [
     {"d":"84","e":"87","p":[{"t":"律師不得受任左列事件，但第三款及第四款之事件經原委任人同意者，不在此限：","ks":["一、依信賴關係或法律顧問關係而常年接受諮詢，與該諮詢事件有關者為對造之事件。","二、與受任之事件利害相反之事件。","三、以現有受任事件之委任人為對造之其他事件。","四、由現在受任事件之對造所委任之其他事件。","五、曾任公務員、依法令從事公務之人員或仲裁人而職務上所處理之事件。","六、律師之財產、業務或個人利益可能影響專業判斷之事件。","七、委任人有數人，而其間利害關係相衝突之事件。"]}]},
     {"d":"87","e":"98","p":[{"t":"律師不得受任左列事件，但第三款及第四款之事件經原委任人同意者，不在此限：","ks":["一、依信賴關係或法律顧問關係而常年接受諮詢，與該諮詢事件有關者為對造之事件。","二、與受任之事件利害相反之事件。","三、以現在受任事件之委任人為對造之其他事件。","四、由現在受任事件之對造所委任之其他事件。","五、本人或同一事務所之律師曾任公務員、依法令從事公務之人員或仲裁人而職務上所處理之事件。但原已受任之事件不在此限。","六、律師之財產、業務或個人利益可能影響專業判斷之事件。","七、委任人有數人，而其間利害關係相衝突之事件。"]}]}
    ]
   },
   "31": {"h":[{"d":"84","e":"98","p":[{"t":"有左列情形之一者，律師應終止與當事人間之委任關係：","ks":["一、律師明知當事人採取法律行動、提出防禦、或在訴訟中為主張之目的僅在恐嚇或惡意損害他人者。","二、律師依其情況明知繼續受任將導致違反本規範者。","三、律師之身心狀況使其難以有效執行職務者。"]},{"t":"律師終止與當事人間之委任關係時，應採取合理步驟，以防止當事人之權益遭受損害，並應返還不相當部份之報酬。","ks":[]}]}]},
   "32": {"h":[{"d":"84","e":"98","p":[{"t":"同一事務所之律師，不得受利害關係相反之當事人委任。","ks":[]},{"t":"律師在受任後知悉有前項情形時，應即通知其委任人，並為適當之處置。","ks":[]}]}]},
   "33": {"h":[{"d":"84","e":"98","p":[{"t":"律師對於受任事件內容應嚴守秘密，不得洩露。但委任人未來之犯罪意圖及計劃或已完成之犯罪行為之延續可能造成第三人生命或身體健康之危害者，不在此限。","ks":[]}]}]},
   "34": {"h":[{"d":"84","e":"98","p":[{"t":"律師對於受任事件代領、代收之款項，應即時交付委任人。","ks":[]},{"t":"律師對於保管與事件有關之物品，應於事件完畢後返還，不得無故遲延或拒絕返還。","ks":[]}]}]},
   "35": {"h":[{"d":"84","e":"98","p":[{"t":"律師應對於委任人明示其酬金及計算方法。","ks":[]},{"t":"律師不得就家事或刑事案件之裁判結果約定後酬。","ks":[]}]}]},
   "36": {"h":[{"d":"84","e":"98","p":[{"t":"律師不得就其所經辦案件之標的中獲取金錢利益，亦不得就尚未終結之訴訟案件直接或間接受讓系爭標的物。","ks":[]}]}]},
   "38": {"h":[{"d":"84","e":"98","p":[{"t":"律師就同一受任事件，不得再接受相對人之委任，同一事件進行中雖與原委任人終止委任，亦不得接受相對人之委任。但同時或先後受雙方當事人之書面委任而從事仲裁、斡旋或調解者，不在此限。","ks":[]}]}],"n":"本條原條文（受任利害衝突事件之限制）於民國98年9月19日修正時刪除，同次修正另增訂現行第38條，二者內容不同。"},
   "41": {"h":[{"d":"84","e":"98","p":[{"t":"律師知悉相對人已委任律師者，不應未經對方律師之同意而直接與相對人聯繫。","ks":[]}]}]},
   "42": {"h":[{"d":"84","e":"98","p":[{"t":"律師間應彼此尊重，顧及同業之正當利益，對於同業之詢問應予答覆或告以不能答覆之理由。","ks":[]}]}]},
   "43": {"h":[{"d":"84","e":"98","p":[{"t":"律師不應詆譭、中傷其他律師，亦不得教唆或放任當事人為之。","ks":[]}]}]},
   "46": {"h":[{"d":"84","e":"98","p":[{"t":"律師基於自己之原因對於同業進行民事或刑事訴訟程序之前，應先通知律師公會。","ks":[]},{"t":"前項程序，若為民事爭議或刑事告訴乃論事件，應先經所屬律師公會試行調解。","ks":[]}]}]},
   "48": {"h":[{"d":"84","e":"98","p":[{"t":"受僱於法律事務所之律師離職時，不應促使該事務所之當事人轉委任自己為受任人。","ks":[]},{"t":"另行受僱於其他法律事務所者，亦同。","ks":[]}]}]},
   "49": {"h":[{"d":"84","e":"92","p":[{"t":"律師違反本規範，由所屬律師公會審議，按左列方法處置之：","ks":["一、勸告。","二、警告","三、情節重大者，送請相關機關處理。"]}]},{"d":"92","e":"98","p":[{"t":"律師違反本規範，由所屬律師公會審議，按左列方法處置之：","ks":["一、勸告。","二、告誡。","三、情節重大者，送請相關機關處理。"]}]}]},
   "50": {"h":[{"d":"84","e":"98","p":[{"t":"本規範經中華民國律師公會全國聯合會會員代表大會通過後施行，並報請法務部備查。修正時，亦同。","ks":[]}]}]},
